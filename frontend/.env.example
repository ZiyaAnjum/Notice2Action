# Notice to Action - Frontend Environment Configuration
# Set to your deployed backend URL in production (e.g., https://notice-to-action-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# SECURITY NOTE:
# Never store backend secrets, database connection strings, or Supabase service-role keys in frontend environment variables.
# Vite prefixes all exposed variables with VITE_ and bundles them into client-side JavaScript.
