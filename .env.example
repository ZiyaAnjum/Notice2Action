# Database Configuration
# Option 1: SQLite for local development and tests (default)
DATABASE_URL=sqlite:///./notice.db

# Option 2: PostgreSQL / Supabase Session Pooler
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# File Storage Configuration (local file storage implementation)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Security & Application Settings
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ENV=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Authentication & JWT Settings
JWT_SECRET=change-this-in-production-to-a-secure-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Email & Notification Delivery
# Options: console (logs to stdout for local dev/testing), smtp (production delivery)
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@notice2action.com
SMTP_PASSWORD=smtp_password_here
SMTP_FROM_EMAIL=Notice2Action <no-reply@notice2action.com>

# LLM & Extraction Service
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.8-flash
OCR_MODE=tesseract
# Optional fallback model attempted once after retries are exhausted
# LLM_FALLBACK_MODEL=gemini-1.5-pro

# Server Host & Port
HOST=0.0.0.0
PORT=8001

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8001
