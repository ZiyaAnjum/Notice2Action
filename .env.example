# Database Configuration
DATABASE_URL=postgresql://notice_user:notice_password@localhost:5432/notice_to_action_db

# Security & Application Settings
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ENV=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM & Extraction Service
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Server Host & Port
HOST=0.0.0.0
PORT=8000
