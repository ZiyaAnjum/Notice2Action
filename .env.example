# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: SQLite for local development and tests (default)
DATABASE_URL=sqlite:///./notice.db

# Option 2: Supabase PostgreSQL (Connection Pooler recommended)
# In Supabase Dashboard: Project Settings -> Database -> Connection string -> URI (Transaction / Session Pooler)
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# Supabase Project Credentials (Backend Only)
# Never expose the SUPABASE_SERVICE_ROLE_KEY to client or frontend code!
# ==============================================================================
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Connection Pooling Settings (active when connecting to PostgreSQL / Supabase)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# File Storage Configuration (local file storage implementation)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Rate Limiting (Upload endpoint protection)
# In-memory sliding-window limiter; protects uploads against DoS/burst attacks
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_SEC=60
RATE_LIMIT_ENABLED=True

# Security & Application Settings
SECRET_KEY=change-this-in-production-to-a-secure-random-secret
ENV=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM & Extraction Service
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
# Optional fallback model attempted once after retries are exhausted
# LLM_FALLBACK_MODEL=gemini-1.5-pro

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8001
